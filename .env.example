# ── Needly environment template ──────────────────────────────────────────────
# Copy to `.env` and fill in what you enable. Everything below has a working
# default for local development; nothing here should ever be committed with
# real values.

# Platform fee charged to renters on top of the listing price (0.08 = 8%)
VITE_PLATFORM_FEE_RATE=0.08

# ── Payments (disabled by default → pay-on-pickup model) ────────────────────
# Set to "razorpay" (INR, recommended) or "stripe" to enable online payments.
# Never put secret keys in frontend code — only the publishable id belongs here.
VITE_PAYMENT_PROVIDER=pay-on-pickup
VITE_RAZORPAY_KEY_ID=
# The secret key lives ONLY on the server that verifies webhooks:
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# ── Email / notifications (disabled → in-app notifications only) ─────────────
# Any SMTP or transactional provider (SendGrid, SES, Resend…)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Needly <hello@needly.in>"

# ── Hosted backend + database (not required for the static build) ────────────
# When migrating the embedded service layer to a hosted API (see README):
# VITE_API_BASE_URL=http://localhost:8080
# DATABASE_URL=postgres://user:pass@host:5432/needly        # server-side only
# AUTH_SECRET=change-me-32+-chars                           # server-side only

# ── Object storage for listing images (disabled → local downscaled data URLs)
# VITE_UPLOAD_PROVIDER=cloudinary
# VITE_CLOUDINARY_CLOUD_NAME=
# S3_BUCKET= / S3_REGION= / S3_ACCESS_KEY_ID= / S3_SECRET_ACCESS_KEY= (server-side)
